# Copie para api/.env (fora do Git) e preencha.
# O arquivo é lido no formato .properties: use / nos caminhos, nunca \.

# OpenAI
OPENAI_API_KEY=
OPENAI_MODEL=gpt-6-luna

# Banco (PostgreSQL): nome do banco, usuário e senha
DB_POSTGRES=sina
DB_USER=
DB_PASSWORD=

# Resend (e-mail ao familiar); o domínio do remetente precisa estar verificado no Resend
RESEND_API_KEY=
MAIL_FROM=alerta@sina.ia.br

# Firebase (push): caminho do JSON da conta de serviço, guardado fora do repositório
# Ex.: C:/Users/voce/sina-firebase-adminsdk.json ou /run/secrets/firebase.json
FIREBASE_CREDENTIALS_PATH=

# Segurança dos dispositivos: segredo aleatório com pelo menos 32 caracteres
DEVICE_TOKEN_PEPPER=
